# Retro Archive settings. Copy to .env and edit:
#
#     cp .env.example .env
#
# .env is read by both ways of running the app:
#   - natively:  python3 app.py
#   - Docker:    docker compose up -d --build
# Real environment variables always win over values in this file.
# .env is gitignored; this example file is the one to commit.

# ---------------------------------------------------------------- both modes

# Port the app is served on (the port you type in the browser).
RETRO_PORT=5050

# Optional. Signs the flash-message cookie. If unset, a random key is made
# each start (harmless; an unread notice is lost on restart). Generate one:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
RETRO_SECRET_KEY=

# Largest file you can upload (cover art and save files), in MB. 64 fits
# any console memory-card image; zip big PC save folders or raise this.
RETRO_MAX_UPLOAD_MB=64

# Optional. Only needed behind a reverse proxy that changes the Host header:
# comma-separated host[:port] values allowed to submit forms.
# RETRO_TRUSTED_ORIGINS=games.home.lan

# ------------------------------------------------------------- native only

# Which interface `python3 app.py` listens on.
#   127.0.0.1 = this computer only (default)
#   0.0.0.0   = also reachable from other machines on your network
RETRO_HOST=127.0.0.1

# Werkzeug debugger and auto-reload. Never enable on a shared network.
RETRO_DEBUG=0

# Where the database and cover art live. Default: ./data next to app.py.
# RETRO_DATA_DIR=/path/to/retro-archive-data

# ------------------------------------------------------------- Docker only

# Which host interface the container's port is published on.
#   0.0.0.0   = reachable from other PCs on your network (default)
#   127.0.0.1 = this machine only
RETRO_BIND_ADDRESS=0.0.0.0

# Host folder holding the database + cover art (mounted at /data).
RETRO_DATA_PATH=./data

# Host folder with your game files, mounted READ-ONLY at /library inside the
# container. In the app, enter copy paths as /library/... (not host paths).
# Point this at a NAS mount if you like, e.g. /mnt/nas/games
RETRO_LIBRARY_DIR=./library

# The app runs as this user/group so ./data stays owned by you. Find yours
# with `id -u` and `id -g`. (The container starts as root only to hand
# ./data to this user, then drops privileges.)
PUID=1000
PGID=1000

# Time zone, so "date completed" defaults to your local today.
TZ=America/New_York
